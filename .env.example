# Servidor
PORT=3000

# Base de datos (SQLite)
DB_PATH=./data/cornex.sqlite

# Autenticacion
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10

# Reglas de negocio
STOCK_BAJO=2
DESCUENTO_PORCENTAJE=25
DESCUENTO_DIAS=30

# Admins que crea el seed (npm run seed)
ADMIN1_NOMBRE=Admin Uno
ADMIN1_EMAIL=admin1@cornex.com
ADMIN1_DNI=11111111
ADMIN1_CLAVE=cambiar_clave_admin1

ADMIN2_NOMBRE=Admin Dos
ADMIN2_EMAIL=admin2@cornex.com
ADMIN2_DNI=22222222
ADMIN2_CLAVE=cambiar_clave_admin2
